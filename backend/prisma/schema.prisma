generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DRIVER
  SUPERVISOR
  ROOT
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  cedula    String   @unique
  email     String   @unique
  password  String
  Visible   Int      @default(1)
  name      String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  routes    Route[]
}

model Route {
  id          Int               @id @default(autoincrement())
  identity    String            @default(uuid())
  name        String
  description String?
  isActive    Boolean           @default(true)
  Visible     Int               @default(1)
  driverId    Int
  driver      User              @relation(fields: [driverId], references: [id])
  positions   VehiclePosition[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Evita que un mismo conductor cree 2 rutas al mismo tiempo exacto
  @@unique([driverId, createdAt])
  @@unique([identity, name])
}

model VehiclePosition {
  id        Int      @id @default(autoincrement())
  identity  String   @unique @default(uuid())
  routeId   Int
  Visible   Int      @default(1)
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  speed     Float    @default(0)
  timestamp DateTime @default(now())

  @@index([routeId, timestamp])
}
